    <stickyBoard>
      <stickyNote location="20,320">
        <body xmi:type="utility:ConstantString" string="Each MQ get, the central call and the ack put are one MQ unit of work. Central commits its ledger first and is idempotent on eventId, so a redelivery after a failure cannot create a second business transaction. HTTP 4xx = permanent rejection (parked on D5.ERROR + rejection ack). 5xx/timeout = rollback; MQ redelivers; after BOTHRESH(3) the message is moved to D5.ERROR - never discarded."/>
      </stickyNote>
    </stickyBoard>
  </eClassifiers>
</ecore:EPackage>
