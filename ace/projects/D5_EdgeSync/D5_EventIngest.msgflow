    <stickyBoard>
      <stickyNote location="20,320">
        <body xmi:type="utility:ConstantString" string="POST /d5/v1/events. Valid events: PERSISTENT put to D5.IN.&lt;priority&gt; (MQ priority 9/5/1, CorrelId=eventId) outside syncpoint so the message is durable before HTTP 202 is returned. Invalid events: parked on D5.ERROR, HTTP 400."/>
